    {
      "id": 13,
      "type": "timeseries",
      "title": "Lähdöt: AC & DC",
      "datasource": {
        "type": "postgres",
        "uid": "DS_POSTGRESQL"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(COALESCE(ac_out_watts,0))) AS value,\n  'AC' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\nGROUP BY 1\nUNION ALL\nSELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(COALESCE(car_watts,0))) AS value,\n  '12V Auto' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\nGROUP BY 1\nUNION ALL\nSELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(COALESCE(typec1_watts+typec2_watts,0))) AS value,\n  'USB-C' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\nGROUP BY 1\nUNION ALL\nSELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(COALESCE(usb1_watts+usb2_watts+qcusb1_watts+qcusb2_watts,0))) AS value,\n  'USB-A' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
