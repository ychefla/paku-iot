      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(bms_temp)) AS value,\n  'BMS (akku)' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\n  AND bms_temp IS NOT NULL AND bms_temp != 0\nGROUP BY 1\nUNION ALL\nSELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(inv_out_temp)) AS value,\n  'Invertteri' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\n  AND inv_out_temp IS NOT NULL AND inv_out_temp != 0\nGROUP BY 1\nUNION ALL\nSELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(mppt_temp)) AS value,\n  'MPPT' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\n  AND mppt_temp IS NOT NULL AND mppt_temp != 0\nGROUP BY 1\nUNION ALL\nSELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(bms_min_cell_temp)) AS value,\n  'Cell Min' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\n  AND bms_min_cell_temp IS NOT NULL AND bms_min_cell_temp != 0\nGROUP BY 1\nUNION ALL\nSELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(bms_max_cell_temp)) AS value,\n  'Cell Max' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\n  AND bms_max_cell_temp IS NOT NULL AND bms_max_cell_temp != 0\nGROUP BY 1\nORDER BY 1"
        }
      ],
