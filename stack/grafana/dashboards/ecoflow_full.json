          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(inv_ac_in_vol)) AS value,\n  'AC Sisään' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\n  AND inv_ac_in_vol > 0\nGROUP BY 1\nUNION ALL\nSELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(inv_out_vol)) AS value,\n  'Invertteri Ulos' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\n  AND inv_out_vol > 0\nGROUP BY 1\nUNION ALL\nSELECT\n  $__timeGroup(ts, $__interval) AS \"time\",\n  AVG(AVG(bms_vol)) AS value,\n  'Akku (BMS)' AS metric\nFROM ecoflow_measurements\nWHERE device_sn = '$device_sn'\n  AND $__timeFilter(ts)\n  AND bms_vol > 0\nGROUP BY 1\nORDER BY 1"
        }
